{
  "builds": [
    {
      "src": "index.cjs",
      "use": "@vercel/node",
      "config": { "includeFiles": ["@waline/**"] }
    },
    {
      "src": "probe.cjs",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/probe", "destination": "/probe" },
    { "source": "/((?!robots\\.txt$).*)", "destination": "/index" }
  ],
  "outputDirectory": "public",
  "engines": { "node": "22.x" },
  "functions": {
    "index.cjs": {
      "includeFiles": ["@waline/**", "node_modules/mongodb/**"],
      "maxDuration": 60
    }
  }
}
